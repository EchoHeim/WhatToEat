page {
  min-height: 100%;
  background: #f7f4ed;
  color: #292824;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

button {
  margin: 0;
}
button::after {
  border: 0;
}

.page-pad {
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.card {
  background: #fffdf8;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(67, 49, 34, 0.07);
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
}
.muted {
  color: #8b8982;
}
.primary-btn {
  background: #e85d3f;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ghost-btn {
  background: #f2eee5;
  color: #4e4c46;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.danger-text {
  color: #c84832;
}
.pill {
  display: inline-flex;
  align-items: center;
  padding: 9rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #f2eee5;
  color: #6c6961;
  font-size: 24rpx;
}
.empty {
  padding: 90rpx 30rpx;
  text-align: center;
  color: #99958c;
}

/* 表单页公共骨架：checkin-form / feedback / reminder-form / record-form / dish-form
   五个页面原本各写一份、逐字相同，放这里改一处就够。 */
.form-page {
  padding-bottom: 60rpx;
}
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eee9e0;
}
