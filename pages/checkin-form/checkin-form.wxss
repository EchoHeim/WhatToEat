page { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; overflow: hidden; }
.form-page { padding-bottom: 60rpx; }

.intro { margin: 8rpx 0 28rpx; }
.eyebrow { color: #E85D3F; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.page-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 800; }

.form-card { padding: 0 28rpx; }
.field { padding: 28rpx 0; border-bottom: 1rpx solid #EEE9E0; }
.field.no-border { border: 0; }
.label { display: block; margin-bottom: 16rpx; font-size: 26rpx; font-weight: 650; }
.field-hint { margin-top: 12rpx; color: #A09C93; font-size: 21rpx; line-height: 1.5; }

.picker-value { display: flex; align-items: center; justify-content: space-between; height: 76rpx; padding: 0 22rpx; background: #F6F2EA; border-radius: 16rpx; font-size: 27rpx; }
.picker-value text:last-child { color: #99958D; font-size: 23rpx; }

.meal-summary { display: flex; align-items: center; padding: 18rpx 22rpx; background: #F6F2EA; border-radius: 16rpx; }
.meal-summary-main { flex: 1; min-width: 0; }
.meal-summary-text { font-size: 26rpx; line-height: 1.5; }
.meal-summary-muted { color: #A09C93; }
.meal-summary-count { margin-left: 12rpx; color: #A09C93; font-size: 21rpx; }
.meal-summary-link { flex: none; margin-left: 16rpx; color: #E85D3F; font-size: 23rpx; font-weight: 650; }
.picker-value text:last-child { color: #99958D; font-size: 23rpx; }
.field textarea { width: 100%; height: 150rpx; padding: 20rpx; box-sizing: border-box; background: #F6F2EA; border-radius: 16rpx; font-size: 26rpx; }

/* 3x3 心情图标，Skyline 下用 Flex 三等分而非 Grid */
.mood-grid { display: flex; flex-wrap: wrap; }
.mood { display: flex; flex-direction: column; align-items: center; width: 33.3333%; flex: none; padding: 18rpx 0; box-sizing: border-box; border: 3rpx solid transparent; border-radius: 18rpx; }
.mood.active { border-color: #E85D3F; background: #FFF0E9; }
.mood-emoji { font-size: 46rpx; line-height: 54rpx; }
.mood-label { margin-top: 8rpx; color: #6C6961; font-size: 21rpx; }
.mood.active .mood-label { color: #B94D35; font-weight: 650; }

.preview { display: flex; align-items: center; margin-top: 24rpx; padding: 26rpx 28rpx; }
.preview-icon { flex: none; margin-right: 18rpx; font-size: 38rpx; }
.preview-text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #4E4C46; font-size: 25rpx; }

.save-btn { height: 92rpx; line-height: 92rpx; margin-top: 28rpx; }
.delete-btn { height: 88rpx; line-height: 88rpx; margin-top: 18rpx; color: #C84832; }
