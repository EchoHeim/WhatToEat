<navigation-bar title="每日签到" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view class="page-pad checkin-page">
  <view class="quote">
    <text class="quote-mark">{{mark}}</text>
    <text class="quote-text">{{quote}}</text>
  </view>

  <view class="today-card card {{checkedToday ? '' : 'pending'}}">
    <view class="today-mood"><image wx:if="{{checkedToday}}" class="today-mood-img" mode="aspectFit" src="{{todayMood.icon}}" /><text wx:else>🌤️</text></view>
    <view class="today-main">
      <view class="today-title">{{checkedToday ? '今天已签到 · ' + todayMood.label : '今天还没签到'}}</view>
      <view class="today-diet">{{checkedToday ? (todayRecord.note || '今天还没写随笔') : '花十秒选个心情，写两句'}}</view>
    </view>
    <view class="today-action {{checkedToday ? '' : 'active'}}" bindtap="openToday">{{checkedToday ? '修改' : '签到'}}</view>
  </view>

  <view class="stats card">
    <view><text class="stat-value">{{streak}}</text><text class="stat-label">连续签到</text></view>
    <view><text class="stat-value">{{monthCount}}</text><text class="stat-label">本月签到</text></view>
    <view><text class="stat-value accent">{{total}}</text><text class="stat-label">累计签到</text></view>
  </view>

  <view class="section-label">最近 14 天</view>
  <view class="strip card">
    <view wx:for="{{strip}}" wx:key="date" class="strip-day {{item.checked ? 'on' : ''}} {{item.isToday ? 'today' : ''}}">
      <image wx:if="{{item.checked}}" class="strip-icon" mode="aspectFit" src="{{item.icon}}" /><text wx:else class="strip-emoji">·</text>
      <text class="strip-num">{{item.day}}</text>
    </view>
  </view>

  <block wx:if="{{tally.length}}">
    <view class="section-label">本月心情</view>
    <view class="tally card">
      <view wx:for="{{tally}}" wx:key="key" class="tally-row">
        <image class="tally-icon" mode="aspectFit" src="{{item.icon}}" />
        <text class="tally-label">{{item.label}}</text>
        <view class="tally-bar"><view class="tally-fill" style="width: {{item.percent}}%"></view></view>
        <text class="tally-count">{{item.count}}</text>
      </view>
    </view>
  </block>

  <view class="section-label">签到记录</view>
  <view wx:if="{{list.length}}" class="card list-card">
    <view wx:for="{{list}}" wx:key="id" class="item" data-id="{{item.id}}" data-date="{{item.date}}" bindtap="openCheckin" bindlongpress="removeCheckin">
      <view class="item-mood"><image class="item-mood-img" mode="aspectFit" src="{{item.icon}}" /></view>
      <view class="item-main">
        <view class="item-head">
          <text class="item-date">{{item.dateLabel}}</text>
          <text class="item-weekday">{{item.weekday}}</text>
          <text wx:if="{{item.isToday}}" class="item-today">今天</text>
        </view>
        <view wx:if="{{item.note}}" class="item-note">{{item.note}}</view>
      </view>
      <text class="item-mood-label">{{item.moodLabel}}</text>
    </view>
  </view>
  <view wx:else class="empty card">还没有签到记录<br/><text>从今天开始，每天留一句</text></view>
</view></scroll-view>
