page { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; overflow: hidden; }
.checkin-page { padding-bottom: 60rpx; }

.title-row { display: flex; justify-content: space-between; align-items: center; margin: 12rpx 0 28rpx; }
.page-title { font-size: 44rpx; font-weight: 800; }
.count { margin-top: 8rpx; font-size: 24rpx; }
.add-btn { height: 72rpx; line-height: 72rpx; padding: 0 25rpx; background: #E85D3F; color: #fff; border-radius: 999rpx; font-size: 25rpx; }

.today-card { display: flex; align-items: center; padding: 30rpx 28rpx; }
.today-card.pending { background: #FFF6EE; }
.today-mood { flex: none; width: 96rpx; height: 96rpx; margin-right: 22rpx; line-height: 96rpx; text-align: center; background: #F5F1E9; border-radius: 30rpx; font-size: 52rpx; }
.today-card.pending .today-mood { background: #FFEBDA; }
.today-main { flex: 1; min-width: 0; }
.today-title { font-size: 30rpx; font-weight: 700; }
.today-diet { margin-top: 8rpx; color: #6C6961; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.today-note { margin-top: 6rpx; color: #9A968D; font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.today-action { flex: none; margin-left: 20rpx; padding: 12rpx 26rpx; background: #F2EEE5; color: #4E4C46; border-radius: 999rpx; font-size: 24rpx; }
.today-action.active { background: #E85D3F; color: #fff; font-weight: 600; }

.stats { display: flex; margin-top: 18rpx; padding: 28rpx 12rpx; }
.stats > view { width: 33.3333%; flex: none; text-align: center; border-right: 1rpx solid #EDE8DE; box-sizing: border-box; }
.stats > view:last-child { border: 0; }
.stat-value, .stat-label { display: block; }
.stat-value { font-size: 38rpx; font-weight: 800; }
.stat-value.accent { color: #D99A20; }
.stat-label { margin-top: 7rpx; color: #969289; font-size: 20rpx; }

.section-label { margin: 34rpx 8rpx 14rpx; color: #89857C; font-size: 23rpx; font-weight: 600; }

/* Skyline 对 Grid 支持不完整，条带固定 7 格一行、用 Flex 换行 */
.strip { display: flex; flex-wrap: wrap; padding: 16rpx 14rpx; }
.strip-day { display: flex; flex-direction: column; align-items: center; width: 14.2857%; flex: none; padding: 10rpx 0; box-sizing: border-box; border-radius: 16rpx; }
.strip-day.on { background: #F6F2EA; }
.strip-day.today { background: #FFF0E9; }
.strip-emoji { font-size: 30rpx; line-height: 36rpx; color: #C9C4BA; }
.strip-num { margin-top: 4rpx; color: #A09C93; font-size: 19rpx; }
.strip-day.on .strip-num { color: #6C6961; }

.tally { padding: 10rpx 26rpx; }
.tally-row { display: flex; align-items: center; padding: 14rpx 0; }
.tally-emoji { width: 48rpx; flex: none; font-size: 32rpx; }
.tally-label { width: 90rpx; flex: none; color: #4E4C46; font-size: 23rpx; }
.tally-bar { flex: 1; height: 14rpx; margin: 0 16rpx; background: #F2EEE5; border-radius: 999rpx; overflow: hidden; }
.tally-fill { height: 14rpx; background: #E8A52A; border-radius: 999rpx; }
.tally-count { width: 46rpx; flex: none; text-align: right; color: #8B8982; font-size: 22rpx; }

.list-card { padding: 0 26rpx; }
.item { display: flex; align-items: flex-start; padding: 26rpx 0; border-bottom: 1rpx solid #EEE9E0; }
.item:last-child { border: 0; }
.item-mood { flex: none; width: 72rpx; height: 72rpx; margin-right: 20rpx; line-height: 72rpx; text-align: center; background: #F6F2EA; border-radius: 22rpx; font-size: 38rpx; }
.item-main { flex: 1; min-width: 0; }
.item-head { display: flex; align-items: center; }
.item-date { font-size: 28rpx; font-weight: 700; }
.item-weekday { margin-left: 12rpx; color: #A09C93; font-size: 20rpx; }
.item-today { margin-left: 12rpx; padding: 2rpx 12rpx; box-sizing: border-box; background: #E85D3F; color: #fff; border-radius: 999rpx; font-size: 18rpx; }
.item-diet { margin-top: 8rpx; color: #4E4C46; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.item-note { margin-top: 6rpx; color: #9A968D; font-size: 21rpx; line-height: 1.5; word-break: break-all; }
.item-mood-label { flex: none; margin-left: 16rpx; color: #8B8982; font-size: 21rpx; }

.empty text { font-size: 23rpx; }
.tip-line { margin-top: 26rpx; text-align: center; color: #ACA89F; font-size: 20rpx; }
