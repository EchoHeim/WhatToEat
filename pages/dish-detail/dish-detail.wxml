<navigation-bar title="菜品详情" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view wx:if="{{dish}}" class="page-pad detail-page">
  <view class="hero card"><view class="hero-emoji">{{dish.emoji}}</view><view class="dish-name">{{dish.name}}</view><view class="muted">{{dish.category}} · {{dish.price || '普通'}}</view><view class="tag-wrap"><text wx:for="{{dish.tags}}" wx:key="*this" class="pill">{{item}}</text></view></view>
  <view class="stats card"><view><text class="stat-main score">★ {{dish.scoreText}}</text><text class="stat-label">个人评分</text></view><view class="line"></view><view><text class="stat-main">{{dish.eatCount}} 次</text><text class="stat-label">累计吃过</text></view><view class="line"></view><view><text class="stat-main date">{{dish.lastEatText}}</text><text class="stat-label">最近一次</text></view></view>
  <view class="info card"><view class="section-title">菜品信息</view><view class="info-row"><text>适合餐次</text><text>{{dish.mealTypesText}}</text></view><view class="info-row"><text>用餐方式</text><text>{{dish.eatTypesText}}</text></view><view class="info-row remark"><text>我的备注</text><text>{{dish.remark || '还没有备注'}}</text></view><view class="info-row"><text>随机推荐</text><text class="{{dish.enableRandom ? 'on' : ''}}">{{dish.enableRandom ? '已开启' : '已关闭'}}</text></view></view>
  <view class="history card"><view class="section-title">最近记录</view><view wx:if="{{records.length}}"><view wx:for="{{records}}" wx:key="id" class="history-row"><view><text>{{item.date}}</text><text class="meal">{{item.mealType}}</text></view><text class="score">★ {{item.score}}</text></view></view><view wx:else class="muted no-history">还没有吃过记录</view></view>
  <button class="primary-btn eat-btn" bindtap="eat">今天吃这个</button><view class="bottom-actions"><button class="ghost-btn" bindtap="edit">编辑</button><button class="ghost-btn danger-text" bindtap="remove">删除</button></view>
</view></scroll-view>
