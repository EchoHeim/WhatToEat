page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page-scroll {
  flex: 1;
  overflow: hidden;
}
.detail-page {
  padding-bottom: 60rpx;
}
.hero {
  text-align: center;
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-more {
  flex: none;
  align-self: flex-end;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -34rpx -28rpx -62rpx 0;
  color: #8b8982;
  font-size: 40rpx;
  line-height: 1;
}
.hero-more-hover {
  background: #f2eee5;
  border-radius: 0 28rpx 0 36rpx;
}
.hero-emoji {
  font-size: 130rpx;
}
.dish-name {
  margin: 8rpx 0 10rpx;
  font-size: 46rpx;
  font-weight: 800;
}
.tag-wrap {
  margin-top: 22rpx;
  width: 100%;
}
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 26rpx 10rpx;
}
.stats > view {
  flex: 1;
  text-align: center;
}
.stat-main,
.stat-label {
  display: block;
}
.stat-main {
  font-size: 28rpx;
  font-weight: 700;
}
.stat-main.score {
  color: #d99a20;
}
.stat-main.date {
  font-size: 23rpx;
}
.stat-label {
  margin-top: 7rpx;
  color: #99958d;
  font-size: 20rpx;
}
.line {
  max-width: 1rpx;
  height: 50rpx;
  background: #e8e3d9;
}
.info,
.history {
  margin-top: 20rpx;
  padding: 28rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee9e0;
  color: #858179;
  font-size: 25rpx;
}
.info-row text:last-child {
  max-width: 68%;
  text-align: right;
  color: #34332f;
}
.info-row.remark {
  align-items: flex-start;
}
.info-row .on {
  color: #43a369 !important;
}
.history-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee9e0;
  font-size: 25rpx;
}
.meal {
  margin-left: 18rpx;
  color: #969289;
}
.meal-time {
  margin-left: 12rpx;
  color: #b4b0a7;
  font-size: 23rpx;
}
.score {
  color: #d99a20;
}
.no-history {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
}
.eat-btn {
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 28rpx;
}
.action-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(41, 40, 36, 0.45);
}
.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f4ed;
  border-radius: 28rpx 28rpx 0 0;
  animation: sheet-up 0.2s ease-out;
}
@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
.action-group {
  background: #fffdf8;
  border-radius: 24rpx;
  overflow: hidden;
}
.action-item {
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  font-size: 32rpx;
  color: #292824;
}
.action-item + .action-item {
  border-top: 1rpx solid #f0ebe1;
}
.action-item.danger {
  color: #c84832;
  font-weight: 600;
}
.action-item-hover {
  background: #f2eee5;
}
.action-cancel {
  margin-top: 16rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  font-size: 32rpx;
  color: #6c6961;
  background: #fffdf8;
  border-radius: 24rpx;
}
.action-cancel-hover {
  background: #f2eee5;
}
