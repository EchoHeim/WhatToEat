page{height:100vh;display:flex;flex-direction:column}.page-scroll{flex:1;overflow:hidden}.detail-page{padding-bottom:60rpx}.hero{text-align:center;padding:34rpx 28rpx}.hero-emoji{font-size:130rpx}.dish-name{margin:8rpx 0 10rpx;font-size:46rpx;font-weight:800}.tag-wrap{margin-top:22rpx}.stats{display:flex;align-items:center;justify-content:space-around;margin-top:20rpx;padding:26rpx 10rpx}.stats>view{flex:1;text-align:center}.stat-main,.stat-label{display:block}.stat-main{font-size:28rpx;font-weight:700}.stat-main.score{color:#D99A20}.stat-main.date{font-size:23rpx}.stat-label{margin-top:7rpx;color:#99958D;font-size:20rpx}.line{max-width:1rpx;height:50rpx;background:#E8E3D9}.info,.history{margin-top:20rpx;padding:28rpx}.info-row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #EEE9E0;color:#858179;font-size:25rpx}.info-row text:last-child{max-width:68%;text-align:right;color:#34332F}.info-row.remark{align-items:flex-start}.info-row .on{color:#43A369!important}.history-row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #EEE9E0;font-size:25rpx}.meal{margin-left:18rpx;color:#969289}.score{color:#D99A20}.no-history{padding:30rpx 0;text-align:center;font-size:24rpx}.eat-btn{height:92rpx;line-height:92rpx;margin-top:28rpx}.bottom-actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:18rpx}.bottom-actions button{height:84rpx;line-height:84rpx}
