<navigation-bar title="{{id ? '编辑菜品' : '添加菜品'}}" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view class="page-pad form-page">
  <view class="form-card card">
    <view class="field"><view class="label">菜品名称 <text>*</text></view><input placeholder="例如：番茄炒蛋" value="{{name}}" data-field="name" bindinput="field" maxlength="20" /></view>
    <view class="field"><view class="label">选一个代表图标</view><view class="emoji-grid"><view wx:for="{{visibleEmojis}}" wx:key="*this" class="emoji-option {{emoji === item ? 'active' : ''}}" data-value="{{item}}" aria-role="button" aria-label="图标 {{item}}{{emoji === item ? '，已选中' : ''}}" bindtap="chooseEmoji">{{item}}</view></view><view class="emoji-more" aria-role="button" aria-label="{{emojiExpanded ? '收起更多图标' : '展开更多图标'}}" bindtap="toggleEmojiAll">{{emojiExpanded ? '收起' : '更多图标 ›'}}</view></view>
    <view class="field"><view class="label">分类 <text>*</text></view><view class="chips"><view wx:for="{{categoryChoices}}" wx:key="value" class="choice {{item.active ? 'active' : ''}}" data-value="{{item.value}}" aria-role="button" aria-label="分类 {{item.value}}{{item.active ? '，已选中' : ''}}" bindtap="chooseCategory">{{item.value}}</view></view><view class="hint">可以多选，选中多个说明这道菜两种都算；「其他」与具体分类互斥</view></view>
    <view class="field"><view class="label">价格</view><view class="price-grid"><view wx:for="{{priceChoices}}" wx:key="value" class="price-option {{item.active ? 'active' : ''}}" data-value="{{item.value}}" aria-role="button" aria-label="价格 {{item.value}}，{{item.range}}{{item.active ? '，已选中' : ''}}" bindtap="choosePrice"><text class="price-name">{{item.value}}</text><text class="price-range">（{{item.range}}）</text></view></view></view>
    <view class="field"><view class="label">适合餐次</view><view class="chips"><view wx:for="{{mealChoices}}" wx:key="value" class="choice {{item.active ? 'active' : ''}}" data-field="mealTypes" data-value="{{item.value}}" aria-role="button" aria-label="适合餐次 {{item.value}}{{item.active ? '，已选中' : ''}}" bindtap="toggleArray">{{item.value}}</view></view></view>
    <view class="field"><view class="label">用餐方式</view><view class="chips"><view wx:for="{{eatChoices}}" wx:key="value" class="choice {{item.active ? 'active' : ''}}" data-field="eatTypes" data-value="{{item.value}}" aria-role="button" aria-label="用餐方式 {{item.value}}{{item.active ? '，已选中' : ''}}" bindtap="toggleArray">{{item.value}}</view></view></view>
    <view class="field"><view class="label">标签</view><input placeholder="多个标签用逗号分隔" value="{{tagsText}}" data-field="tagsText" bindinput="field" /></view>
    <view class="field"><view class="label">备注</view><textarea placeholder="记录口味、店铺或烹饪小技巧" value="{{remark}}" data-field="remark" bindinput="field" maxlength="200" /></view>
    <view class="switch-row"><view><view class="label no-margin">参与随机推荐</view><view class="hint">关闭后不会在首页被抽中</view></view><switch color="#E85D3F" checked="{{enableRandom}}" aria-label="参与随机推荐" bindchange="switchRandom" /></view>
  </view>
  <button class="primary-btn save-btn" bindtap="save">保存菜品</button>
</view></scroll-view>
