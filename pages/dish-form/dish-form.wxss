page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page-scroll {
  flex: 1;
  overflow: hidden;
}
.form-card {
  padding: 4rpx 28rpx;
}
.label {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 650;
}
.label text {
  color: #e85d3f;
}
.field input {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: #f6f2ea;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.field textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f6f2ea;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 13rpx;
}
.emoji-option {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  background: #f6f2ea;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  font-size: 38rpx;
}
.emoji-option.active {
  border-color: #e85d3f;
  background: #fff1ea;
}
.emoji-more {
  margin-top: 16rpx;
  color: #c2563a;
  font-size: 23rpx;
  font-weight: 600;
}
.price-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.price-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48.5%;
  flex: none;
  height: 78rpx;
  margin-bottom: 14rpx;
  background: #f6f2ea;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.price-option.active {
  border-color: #e85d3f;
  background: #fff1ea;
}
.price-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4e4c46;
}
.price-range {
  font-size: 20rpx;
  color: #a8a49b;
}
.price-option.active .price-name {
  color: #b94d35;
}
.price-option.active .price-range {
  color: #ce9b89;
}
.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.choice {
  padding: 13rpx 24rpx;
  background: #f3efe7;
  color: #706d65;
  border-radius: 999rpx;
  font-size: 25rpx;
}
.choice.active {
  background: #292824;
  color: #fff;
}
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}
.no-margin {
  margin: 0;
}
.hint {
  margin-top: 6rpx;
  color: #99958d;
  font-size: 21rpx;
}
.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 30rpx;
}
