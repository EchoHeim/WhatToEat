page{height:100vh;display:flex;flex-direction:column}.page-scroll{flex:1;overflow:hidden}.form-page{padding-bottom:60rpx}.form-card{padding:4rpx 28rpx}.field{padding:28rpx 0;border-bottom:1rpx solid #EEE9E0}.label{margin-bottom:18rpx;font-size:26rpx;font-weight:650}.label text{color:#E85D3F}.field input,.picker-value{height:72rpx;line-height:72rpx;padding:0 20rpx;background:#F6F2EA;border-radius:16rpx;font-size:27rpx}.field textarea{width:100%;height:160rpx;padding:20rpx;box-sizing:border-box;background:#F6F2EA;border-radius:16rpx;font-size:27rpx}.emoji-grid{display:flex;flex-wrap:wrap;gap:13rpx}.emoji-option{width:70rpx;height:70rpx;line-height:70rpx;text-align:center;background:#F6F2EA;border:3rpx solid transparent;border-radius:16rpx;font-size:38rpx}.emoji-option.active{border-color:#E85D3F;background:#FFF1EA}.emoji-more{margin-top:16rpx;color:#C2563A;font-size:23rpx;font-weight:600}.price-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.price-option{display:flex;align-items:center;justify-content:center;width:48.5%;flex:none;height:78rpx;margin-bottom:14rpx;background:#F6F2EA;border:3rpx solid transparent;border-radius:16rpx;box-sizing:border-box}.price-option.active{border-color:#E85D3F;background:#FFF1EA}.price-name{font-size:26rpx;font-weight:600;color:#4E4C46}.price-range{font-size:20rpx;color:#A8A49B}.price-option.active .price-name{color:#B94D35}.price-option.active .price-range{color:#CE9B89}.split{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.picker-value{min-width:250rpx;display:flex;justify-content:space-between}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.choice{padding:13rpx 24rpx;background:#F3EFE7;color:#706D65;border-radius:999rpx;font-size:25rpx}.choice.active{background:#292824;color:#fff}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0}.no-margin{margin:0}.hint{margin-top:6rpx;color:#99958D;font-size:21rpx}.save-btn{height:92rpx;line-height:92rpx;margin-top:30rpx}
