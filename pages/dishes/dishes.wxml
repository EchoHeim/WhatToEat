<import src="/styles/tabbar.wxml" />
<navigation-bar title="我的菜谱" back="{{false}}" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-pad">
    <view class="title-row"><view class="title-main"><view class="page-title">{{tab === 'mine' ? '我的菜品库' : '推荐菜谱'}}</view><view class="muted count">{{tab === 'mine' ? '已经收藏 ' + total + ' 道好吃的' : recipeTotal + ' 道 · 挑一道收进自己的菜谱'}}</view></view><view wx:if="{{tab === 'mine'}}" class="add-btn" hover-class="add-btn-hover" aria-role="button" aria-label="添加菜品" bindtap="addDish">＋ 添加</view></view>
    <view class="seg"><view class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-tab="mine" aria-role="tab" aria-label="我的菜谱{{tab === 'mine' ? '，已选中' : ''}}" bindtap="switchTab">我的菜谱</view><view class="seg-item {{tab === 'recommend' ? 'on' : ''}}" data-tab="recommend" aria-role="tab" aria-label="推荐菜谱{{tab === 'recommend' ? '，已选中' : ''}}" bindtap="switchTab">推荐菜谱</view></view>
    <view class="search"><text class="search-icon">⌕</text><input placeholder="{{tab === 'mine' ? '搜索菜品或标签' : '搜索菜名、标签或推荐理由'}}" value="{{keyword}}" bindinput="search" confirm-type="search" /></view>
    <block wx:if="{{tab === 'mine'}}">
      <view class="category-row"><view wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" data-value="{{item}}" aria-role="button" aria-label="{{item}}{{activeCategory === item ? '，已选中' : ''}}" bindtap="chooseCategory">{{item}}</view></view>
      <view class="list-head"><text class="section-title">{{activeCategory}}</text><picker range="{{sortOptions}}" bindchange="changeSort"><view class="sort"><text>{{sort}}</text><view class="sort-caret"></view></view></picker></view>
      <view wx:if="{{dishes.length}}" class="dish-list">
        <view wx:for="{{dishes}}" wx:key="id" class="dish-card card" data-id="{{item.id}}" aria-role="button" aria-label="{{item.name}}，{{item.category}}，{{item.eatTypes[0] || '未设置方式'}}，评分 {{item.scoreText}}，吃过 {{item.eatCount}} 次" bindtap="openDish">
          <view class="dish-emoji">{{item.emoji}}</view><view class="dish-main"><view class="dish-name">{{item.name}}</view><view class="dish-meta">{{item.category}} · {{item.eatTypes[0] || '未设置方式'}}</view><view class="tag-line"><text>{{item.tagText}}</text></view></view>
          <view class="dish-side"><text class="score">★ {{item.scoreText}}</text><text class="times">吃过 {{item.eatCount}} 次</text><text class="arrow">›</text></view>
        </view>
      </view>
      <view wx:else class="empty card">没有找到菜品<br/><text>换个关键词，或者添加一道新菜吧</text></view>
    </block>
    <block wx:else>
      <view wx:for="{{crowdRows}}" wx:key="group" class="crowd-row"><view wx:for="{{item.items}}" wx:for-item="chip" wx:key="key" class="crowd-chip {{chip.active ? 'active' : ''}}" data-key="{{chip.key}}" aria-role="button" aria-label="{{chip.label}}{{chip.active ? '，已选中' : ''}}" bindtap="chooseCrowd">{{chip.label}}</view></view>
      <view wx:if="{{crowdNote}}" class="crowd-note">{{crowdNote}}</view>
      <view wx:if="{{recipeList.length}}" class="dish-list">
        <view wx:for="{{recipeList}}" wx:key="id" class="dish-card card recipe-card">
          <view class="dish-emoji">{{item.emoji}}</view>
          <view class="dish-main"><view class="dish-name">{{item.name}}</view><view class="dish-meta">{{item.crowdText}} · {{item.price}}</view><view class="recipe-why">{{item.why}}</view></view>
          <view class="collect {{item.owned ? 'owned' : ''}}" data-id="{{item.id}}" aria-role="button" aria-label="{{item.owned ? item.name + '，已收藏' : '收藏 ' + item.name}}" bindtap="collectRecipe">{{item.owned ? '已收藏' : '＋ 收藏'}}</view>
        </view>
      </view>
      <view wx:else class="empty card">这一组没有菜<br/><text>换个关键词，或者切到「全部」看看</text></view>
    </block>
  </view>
</scroll-view>
<template is="app-tabbar" data="{{...tabbar}}" />
