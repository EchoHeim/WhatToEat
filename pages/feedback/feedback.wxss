page { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; overflow: hidden; }
.form-page { padding-bottom: 60rpx; }

.intro { margin: 8rpx 0 28rpx; }
.eyebrow { color: #E85D3F; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.page-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 800; }
.intro-sub { margin-top: 14rpx; color: #8B8982; font-size: 24rpx; line-height: 1.65; }

.form-card { padding: 0 28rpx; }
.field { padding: 28rpx 0; border-bottom: 1rpx solid #EEE9E0; }
.field.no-border { border: 0; }
.label { display: block; margin-bottom: 16rpx; font-size: 26rpx; font-weight: 650; }
.label-extra { margin-left: 10rpx; color: #A09C93; font-size: 21rpx; font-weight: 400; }

.segment { display: flex; padding: 6rpx; background: #F2EEE5; border-radius: 16rpx; }
.seg { flex: 1; padding: 16rpx 0; text-align: center; border-radius: 12rpx; color: #6C6961; font-size: 26rpx; }
.seg.active { background: #FFFDF8; color: #292824; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(67, 49, 34, .08); }

/* 写反馈需要的地方比记备注多，给足高度；底部留 40rpx 让最后一行不贴着边框 */
.feedback-textarea { width: 100%; height: 260rpx; padding: 20rpx; box-sizing: border-box; background: #F6F2EA; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }
.counter { margin-top: 10rpx; text-align: right; color: #B0ACA3; font-size: 21rpx; }
.counter-warn { color: #C84832; font-weight: 650; }

.shot-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.shot { position: relative; width: 168rpx; height: 168rpx; border-radius: 18rpx; overflow: hidden; background: #F6F2EA; }
.shot-img { width: 100%; height: 100%; }
/* 删除角标压在右上角，深色底 + 白描边，浅色截图上也看得清 */
.shot-del {
  position: absolute; top: 0; right: 0;
  display: flex; align-items: center; justify-content: center;
  width: 40rpx; height: 40rpx;
  border-bottom-left-radius: 16rpx;
  background: rgba(41, 40, 36, .62); color: #fff;
  font-size: 28rpx; line-height: 1;
}
.shot-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #DCD5C8; box-sizing: border-box; background: #FBF8F1; }
.shot-add-hover { background: #F4EFE4; }
.shot-plus { color: #B0A99C; font-size: 42rpx; line-height: 1; }
.shot-tip { margin-top: 8rpx; color: #A8A29A; font-size: 20rpx; }

.text-input { width: 100%; height: 76rpx; padding: 0 22rpx; box-sizing: border-box; background: #F6F2EA; border-radius: 16rpx; font-size: 27rpx; }

.meta-card { margin-top: 20rpx; padding: 24rpx 28rpx 20rpx; }
.meta-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.meta-title { color: #292824; font-size: 26rpx; font-weight: 700; }
.meta-badge { padding: 4rpx 14rpx; background: #F2EEE5; color: #8B8982; border-radius: 999rpx; font-size: 19rpx; }
.meta-row { display: flex; align-items: baseline; padding: 12rpx 0; border-bottom: 1rpx solid #F1EDE4; }
.meta-row.last { border: 0; }
.meta-label { flex: none; width: 90rpx; color: #8B8982; font-size: 23rpx; }
.meta-value { flex: 1; min-width: 0; color: #4E4C46; font-size: 24rpx; word-break: break-all; }
.meta-foot { margin-top: 8rpx; color: #A09C93; font-size: 20rpx; line-height: 1.55; }

.submit-btn { height: 92rpx; line-height: 92rpx; margin-top: 30rpx; }
/* Skyline 下属性选择器（[disabled]）不保证生效，用 class 切换更稳 */
.submit-btn.is-busy { opacity: .7; }
.foot-hint { margin-top: 16rpx; text-align: center; color: #A09C93; font-size: 20rpx; }
