.confetti-bit.d8{animation:cf-d8 .95s cubic-bezier(.14,.68,.3,1) both}
@keyframes cf-d8{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}10%{opacity:1}52%{transform:translate(-141rpx,-101rpx) rotate(-140deg) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-201rpx,-90rpx) rotate(-280deg) scale(.9)}}
