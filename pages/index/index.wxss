@import "../../styles/tabbar.wxss";
page { height: 100vh; display: flex; flex-direction: column; }.scrollarea { flex: 1; overflow: hidden; }.home { padding-bottom: 210rpx; }
.hello-row { display:flex;align-items:center;justify-content:space-between;margin:12rpx 0 30rpx; }.eyebrow{color:#E85D3F;font-size:21rpx;font-weight:800;letter-spacing:4rpx}.headline{margin-top:8rpx;font-size:40rpx;font-weight:800}.filter-entry{display:flex;align-items:center;gap:8rpx;padding:16rpx 22rpx;border-radius:999rpx;background:#FFFDF8;font-size:26rpx}.filter-badge{width:32rpx;height:32rpx;line-height:32rpx;text-align:center;color:#fff;background:#E85D3F;border-radius:50%;font-size:20rpx}
.checkin-bar{display:flex;align-items:center;margin-bottom:24rpx;padding:22rpx 26rpx;background:#FFFDF8;border-radius:24rpx;box-shadow:0 10rpx 28rpx rgba(67,49,34,.06)}.checkin-bar-emoji{flex:none;width:64rpx;height:64rpx;margin-right:18rpx;line-height:64rpx;text-align:center;background:#F6F2EA;border-radius:20rpx;font-size:34rpx}.checkin-bar-icon{flex:none;width:64rpx;height:64rpx;margin-right:18rpx}.checkin-bar-body{flex:1;min-width:0;display:flex;flex-direction:column}.checkin-bar-title{font-size:27rpx;font-weight:700}.checkin-bar-sub{margin-top:5rpx;color:#9A968D;font-size:21rpx}.checkin-bar-go{flex:none;margin-left:16rpx;color:#E85D3F;font-size:23rpx}
.filter-card{margin-bottom:24rpx;padding:28rpx}.filter-head{display:flex;justify-content:space-between;align-items:center}.clear{color:#E85D3F;font-size:25rpx}.filter-label{margin:22rpx 0 12rpx;color:#88847B;font-size:24rpx}.chip-row{display:flex;flex-wrap:wrap;gap:12rpx}.choice{padding:11rpx 20rpx;background:#F4F0E8;color:#6B6861;border-radius:999rpx;font-size:24rpx}.choice.active{background:#292824;color:#fff}
.result-card{padding:28rpx 32rpx 30rpx;text-align:center;transition:transform .25s,opacity .25s}.result-card.rolling{transform:scale(.97) rotate(-1deg);opacity:.55}.candidate-count{display:inline-block;padding:8rpx 18rpx;border-radius:999rpx;background:#F7E7DD;color:#B7543D;font-size:21rpx}.food-emoji{margin:24rpx 0 10rpx;font-size:126rpx;line-height:1.2}.food-name{font-size:48rpx;font-weight:800}.meta{margin:12rpx 0 20rpx;color:#858179;font-size:26rpx}.tags{min-height:58rpx}.facts{display:flex;justify-content:space-around;align-items:center;margin:22rpx 0 28rpx;padding:24rpx 8rpx;border-top:1rpx solid #EEE9DF;border-bottom:1rpx solid #EEE9DF}.fact{flex:1;display:flex;flex-direction:column;gap:6rpx}.fact-value{min-height:38rpx;font-size:27rpx;font-weight:700}.fact-value.accent{color:#E3A228}.fact-value.small{font-size:23rpx}.fact-label{color:#9B978E;font-size:20rpx}.divider{width:1rpx;height:48rpx;background:#E8E3D9}.main-action{height:88rpx;line-height:88rpx}.secondary-actions{display:flex;justify-content:center;gap:76rpx;margin-top:26rpx;color:#67645D;font-size:26rpx}
.dice-btn{width:100%;height:100rpx;margin-top:28rpx;line-height:100rpx;border-radius:28rpx;background:#292824;color:#fff;font-size:32rpx;font-weight:700;box-shadow:0 14rpx 30rpx rgba(41,40,36,.18)}.dice{margin-right:10rpx}.rule-tip{margin:18rpx 0 0;text-align:center;color:#9B978F;font-size:22rpx}.no-result{padding:70rpx 40rpx;text-align:center}.no-result .tip{margin:18rpx 0 32rpx;font-size:25rpx}
.result-card.rolling{transform:none;opacity:1}.lottery{position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column;height:520rpx;overflow:hidden}.lottery-orbit{position:absolute;width:300rpx;height:300rpx;border:3rpx dashed #F0B9A9;border-radius:50%;animation:orbit 1.2s linear infinite}.lottery-emoji{position:relative;margin:0 0 18rpx;animation:food-pop .2s ease-out infinite alternate}.lottery-tip{margin-top:18rpx;color:#A09C93;font-size:24rpx}.dice-btn.disabled{opacity:.78}.dice-btn.disabled:active{transform:none}@keyframes orbit{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}@keyframes food-pop{from{transform:scale(.88) rotate(-5deg)}to{transform:scale(1.05) rotate(5deg)}}
/* 摇骰落定：像撕开礼品袋，彩带以菜品为中心向四周迸射，飞到卡片外再淡出。
   12 个方向固定成 12 条 keyframes：角度 / 动画只能写在样式表里，
   Skyline 下内联 animation-*（哪怕只写 animation-delay）会让整条动画不播，踩过。 */
.result-card{position:relative}
.result-card.bursting{animation:card-pop .36s cubic-bezier(.2,.72,.3,1)}
.confetti-bit{position:absolute;opacity:0;z-index:9;pointer-events:none}
.confetti-bit.d1{animation:cf-d1 .95s cubic-bezier(.14,.68,.3,1) both}
@keyframes cf-d1{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}10%{opacity:1}52%{transform:translate(183rpx,-20rpx) rotate(150deg) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(262rpx,26rpx) rotate(300deg) scale(.9)}}
