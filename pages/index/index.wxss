@keyframes cf-d10{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}10%{opacity:1}52%{transform:translate(0rpx,-189rpx) rotate(-170deg) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(0rpx,-216rpx) rotate(-340deg) scale(.9)}}
.confetti-bit.d11{animation:cf-d11 .95s cubic-bezier(.14,.68,.3,1) both}
@keyframes cf-d11{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}10%{opacity:1}52%{transform:translate(101rpx,-194rpx) rotate(130deg) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(144rpx,-223rpx) rotate(260deg) scale(.9)}}
.confetti-bit.d12{animation:cf-d12 .95s cubic-bezier(.14,.68,.3,1) both}
@keyframes cf-d12{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}10%{opacity:1}52%{transform:translate(137rpx,-99rpx) rotate(-150deg) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(196rpx,-87rpx) rotate(-300deg) scale(.9)}}
@keyframes card-pop{0%{transform:scale(.94)}55%{transform:scale(1.015)}100%{transform:scale(1)}}
