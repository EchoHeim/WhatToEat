/* 最近吃过：首页的「一键再记一次」。记一餐表单要点五次，
   而「昨天吃了什么、今天再来一次」是最高频的路径，这里给个直达入口。 */
.recent-block {
  margin-top: 38rpx;
}
.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.recent-hint {
  color: #b4b0a6;
  font-size: 21rpx;
}
.recent-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.recent-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx 12rpx 16rpx;
  background: #fffdf8;
  border: 1rpx solid #f0eae0;
  border-radius: 999rpx;
}
.recent-chip:active {
  background: #f7f2e9;
}
/* 同一个道理：图标的间距别交给 gap，显式给 margin（字形宽度跟设备字体走） */
.recent-emoji {
  flex: none;
  margin-right: 10rpx;
  font-size: 32rpx;
  line-height: 1;
}
.recent-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.recent-name {
  font-size: 25rpx;
  font-weight: 600;
  color: #292824;
}
.recent-ago {
  margin-top: 2rpx;
  color: #a9a59b;
  font-size: 19rpx;
}
