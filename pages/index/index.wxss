@import '../../styles/tabbar.wxss';
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow: hidden;
}
.home {
  padding-bottom: 210rpx;
}
.hello-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 30rpx;
}
.eyebrow {
  color: #e85d3f;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.headline {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
}
/* 筛选按钮和餐次一起浮在菜品卡顶部：放在 wrap 上而不是 card 里，
   这样「没有符合条件的菜」那张卡照样能点，不然筛窄了就没入口了 */
.result-wrap {
  position: relative;
}
.card-tools {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.meal-chips {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}
.meal-chip {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f0e8;
  color: #6b6861;
  font-size: 22rpx;
}
.meal-chip.active {
  background: #292824;
  color: #fff;
}
.filter-entry {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 12rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f0e8;
  color: #6b6861;
  font-size: 22rpx;
}
.filter-badge {
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  text-align: center;
  color: #fff;
  background: #e85d3f;
  border-radius: 999rpx;
  font-size: 19rpx;
}
.checkin-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(67, 49, 34, 0.06);
}
.checkin-bar-emoji {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f6f2ea;
  border-radius: 20rpx;
  font-size: 34rpx;
}
.checkin-bar-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
}
.checkin-bar-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.checkin-bar-title {
  font-size: 27rpx;
  font-weight: 700;
}
.checkin-bar-sub {
  margin-top: 5rpx;
  color: #9a968d;
  font-size: 21rpx;
}
.checkin-bar-go {
  flex: none;
  margin-left: 16rpx;
  color: #e85d3f;
  font-size: 23rpx;
}
.filter-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}
.filter-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.filter-actions {
  display: flex;
  align-items: center;
  gap: 26rpx;
}
.clear {
  color: #e85d3f;
  font-size: 25rpx;
}
.collapse {
  color: #6c6961;
  font-size: 25rpx;
}
.filter-label {
  margin: 22rpx 0 12rpx;
  color: #88847b;
  font-size: 24rpx;
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.choice {
  padding: 11rpx 20rpx;
  background: #f4f0e8;
  color: #6b6861;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.choice.active {
  background: #292824;
  color: #fff;
}
.result-card {
  padding: 76rpx 32rpx 30rpx;
  text-align: center;
  transition:
    transform 0.25s,
    opacity 0.25s;
}
.result-card.rolling {
  transform: scale(0.97) rotate(-1deg);
  opacity: 0.55;
}
.food-emoji {
  margin: 24rpx 0 10rpx;
  font-size: 126rpx;
  line-height: 1.2;
}
.food-name {
  font-size: 48rpx;
  font-weight: 800;
}
.meta {
  margin: 12rpx 0 20rpx;
  color: #858179;
  font-size: 26rpx;
}
.tags {
  min-height: 58rpx;
}
.facts {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 22rpx 0 28rpx;
  padding: 24rpx 8rpx;
  border-top: 1rpx solid #eee9df;
  border-bottom: 1rpx solid #eee9df;
}
.fact {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.fact-value {
  min-height: 38rpx;
  font-size: 27rpx;
  font-weight: 700;
}
.fact-value.accent {
  color: #e3a228;
}
.fact-value.small {
  font-size: 23rpx;
}
.fact-label {
  color: #9b978e;
  font-size: 20rpx;
}
.divider {
  width: 1rpx;
  height: 48rpx;
  background: #e8e3d9;
}
.main-action {
  height: 88rpx;
  line-height: 88rpx;
} /* 推荐菜还没有 id，进不了详情页；这行小字说明它从哪来、点确认会发生什么 */
.recommend-tip {
  margin: -6rpx 0 16rpx;
  color: #b07a3c;
  font-size: 21rpx;
}
.secondary-actions {
  display: flex;
  justify-content: center;
  gap: 76rpx;
  margin-top: 26rpx;
  color: #67645d;
  font-size: 26rpx;
}
.dice-btn {
  width: 100%;
  height: 100rpx;
  margin-top: 28rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  background: #292824;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(41, 40, 36, 0.18);
} /* 图标 / 文字 / 数量三块横排：写在按钮里的一段长文案会被挤到换行，还会顶出按钮高度 */
/* 骰子不靠 gap 拉开：Skyline 在部分客户端版本（1.4.1 之前）不支持 flex 的 gap，
   而 emoji 的字形宽度又跟着设备字体走（三星那套是 1.17em，比测量宽度宽），
   两样叠在一起，骰子就压到「开始随机选」上。改成固定宽度的盒子 + margin，
   空间自己算，不跟渲染引擎要。48rpx 比 34rpx 字号宽出 14rpx，专门留溢出的余量。 */
.dice {
  flex: none;
  width: 48rpx;
  margin-right: 12rpx;
  font-size: 34rpx;
  line-height: 1.2;
  text-align: center;
}
.dice-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.dice-label {
  flex: none;
  white-space: nowrap;
}
.dice-count {
  flex: none;
  margin-left: 32rpx;
  min-width: 52rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
}
.rule-tip {
  margin: 18rpx 0 0;
  text-align: center;
  color: #9b978f;
  font-size: 22rpx;
}
.no-result {
  padding: 96rpx 40rpx 70rpx;
  text-align: center;
}
.no-result .tip {
  margin: 18rpx 0 32rpx;
  font-size: 25rpx;
}
.result-card.rolling {
  transform: none;
  opacity: 1;
}
.lottery {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 520rpx;
  overflow: hidden;
}
.lottery-orbit {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border: 3rpx dashed #f0b9a9;
  border-radius: 50%;
  animation: orbit 1.2s linear infinite;
}
.lottery-emoji {
  position: relative;
  margin: 0 0 18rpx;
  animation: food-pop 0.2s ease-out infinite alternate;
}
.lottery-tip {
  margin-top: 18rpx;
  color: #a09c93;
  font-size: 24rpx;
}
.dice-btn.disabled {
  opacity: 0.78;
}
.dice-btn.disabled:active {
  transform: none;
}
@keyframes orbit {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
@keyframes food-pop {
  from {
    transform: scale(0.88) rotate(-5deg);
  }
  to {
    transform: scale(1.05) rotate(5deg);
  }
}
/* 摇骰落定：像撕开礼品袋，彩带以菜品为中心向四周迸射，飞到卡片外再淡出。
   12 个方向固定成 12 条 keyframes：角度 / 动画只能写在样式表里，
   Skyline 下内联 animation-*（哪怕只写 animation-delay）会让整条动画不播，踩过。 */
.result-card {
  position: relative;
}
.result-card.bursting {
  animation: card-pop 0.36s cubic-bezier(0.2, 0.72, 0.3, 1);
}
.confetti-bit {
  position: absolute;
  opacity: 0;
  z-index: 9;
  pointer-events: none;
}
.confetti-bit.d1 {
  animation: cf-d1 0.95s cubic-bezier(0.14, 0.68, 0.3, 1) both;
}
@keyframes cf-d1 {
  0% {
    opacity: 0;
    transform: translate(0, 0) rotate(0deg) scale(0.4);
  }
  10% {
    opacity: 1;
  }
  52% {
    transform: translate(183rpx, -20rpx) rotate(150deg) scale(1);
  }
  80% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(262rpx, 26rpx) rotate(300deg) scale(0.9);
  }
}
.confetti-bit.d2 {
  animation: cf-d2 0.95s cubic-bezier(0.14, 0.68, 0.3, 1) both;
}
@keyframes cf-d2 {
  0% {
    opacity: 0;
    transform: translate(0, 0) rotate(0deg) scale(0.4);
  }
  10% {
    opacity: 1;
  }
  52% {
