@import '../../styles/tabbar.wxss';
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page-scroll {
  flex: 1;
  overflow: hidden;
}
.profile-page {
  padding-bottom: 0;
}
.profile-head {
  display: flex;
  align-items: center;
  margin: 12rpx 0 28rpx;
}
.avatar-wrap {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-right: 28rpx;
  flex: none;
}
.avatar-image,
.avatar-placeholder {
  display: block;
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
}
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #292824;
  color: #fff;
  font-size: 52rpx;
}
.avatar-edit {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  z-index: 1;
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  background: #e85d3f;
  color: #fff;
  border: 4rpx solid #f7f4ed;
  border-radius: 50%;
  font-size: 20rpx;
  box-sizing: content-box;
  pointer-events: none;
}
.avatar-hit {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 108rpx;
  height: 108rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
}
.profile-info {
  flex: 1;
  min-width: 0;
}
.profile-name {
  width: 100%;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 36rpx;
  font-weight: 800;
}
.profile-sub {
  margin-top: 8rpx;
  white-space: nowrap;
  font-size: 21rpx;
}
.stats {
  display: flex;
  padding: 30rpx 12rpx;
}
.stats > view {
  width: 33.3333%;
  flex: none;
  text-align: center;
  border-right: 1rpx solid #ede8de;
  box-sizing: border-box;
}
.stats > view:last-child {
  border: 0;
}
.stat-value,
.stat-label {
  display: block;
}
.stat-value {
  font-size: 38rpx;
  font-weight: 800;
}
.stat-value.accent {
  color: #d99a20;
}
.stat-label {
  margin-top: 7rpx;
  color: #969289;
  font-size: 20rpx;
}
.favorite {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
}
.favorite-icon {
  margin-right: 20rpx;
  font-size: 44rpx;
}
.tiny {
  font-size: 20rpx;
}
.favorite-name {
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 700;
}
.section-label {
  margin: 34rpx 8rpx 14rpx;
  color: #89857c;
  font-size: 23rpx;
  font-weight: 600;
}
/* 「提醒」区块的两个新建入口：并排各占一半，比下面那行列表入口更好点 */
.reminder-new {
  display: flex;
  margin-bottom: 16rpx;
}
.new-card {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 22rpx 18rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(67, 49, 34, 0.07);
}
.new-card + .new-card {
  margin-left: 16rpx;
}
.new-card-hover {
  opacity: 0.72;
}
/* 图标与文字拉开：12rpx 时两行字几乎贴着图标，文字整体也过分靠左 */
.new-emoji {
  margin-right: 24rpx;
  font-size: 36rpx;
}
.new-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.new-name {
  display: block;
  color: #2e2c28;
  font-size: 26rpx;
  font-weight: 600;
}
.new-desc {
  display: block;
  margin-top: 5rpx;
  color: #9a968d;
  font-size: 19rpx;
}
.settings {
  padding: 0 28rpx;
}
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 102rpx;
  border-bottom: 1rpx solid #eee9e0;
}
.setting-row:last-child {
  border: 0;
}
.setting-name,
.setting-desc {
  display: block;
}
.setting-name {
  font-size: 27rpx;
  font-weight: 600;
}
.setting-desc {
  margin-top: 7rpx;
  color: #9a968d;
  font-size: 20rpx;
}
.setting-value {
  color: #969289;
  font-size: 24rpx;
}
.setting-tail {
  display: flex;
  align-items: center;
}
.setting-badge {
  min-width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: #e85d3f;
  color: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}
/* 推送没开时的提示：挂在「提醒事项」卡片下面，点它去小程序设置页。开着时这行整个不渲染 */
.push-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 8rpx 0;
  color: #c84832;
  font-size: 21rpx;
  line-height: 1.4;
}
.push-tip-go {
  flex: none;
  margin-left: 16rpx;
  font-weight: 600;
}
/* 「喜欢开发者」（官方 reward 组件，基础库 3.17.5+）跟在「危险操作」下面、版本号上面，跟页面一起滚。
   theme 用 transparent：白底会把整个卡片范围涂成一块白，只需要那个红按钮露出来。
   组件自己上下各带一大截内边距，透明后就成了一片纯留白，用负 margin 收掉大半。
   嫌紧就把 -30 往 0 调，嫌松就往 -40 调，只影响这一处。 */
.reward-wrap {
  margin: -30rpx 0 -30rpx;
}
/* 版本号跟内容一起滚动（不固定），底部留白让开悬浮 tabBar */
.version-bar {
  margin-top: 10rpx;
  padding-bottom: 210rpx;
  text-align: center;
  color: #aca89f;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
