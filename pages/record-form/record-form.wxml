<navigation-bar title="{{pageTitle}}" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view class="page-pad form-page">
  <view class="intro"><view class="eyebrow">MEAL LOG</view><view class="page-title">今天吃得怎么样？</view></view>
  <view class="form-card card">
    <view class="field"><view class="label">吃了什么</view><view class="picker-value" bindtap="toggleDishSheet"><view class="picker-dish"><text wx:if="{{dishEmoji}}" class="picker-emoji">{{dishEmoji}}</text><text>{{dishId ? dishName : '选择菜品'}}</text></view><text class="picker-hint">{{dishSheetOpen ? '收起' : (dishId ? '更换 ›' : '选择 ›')}}</text></view><view wx:if="{{dishSheetOpen}}" class="dish-sheet"><view class="sheet-search"><text class="sheet-search-icon">🔍</text><input class="sheet-search-input" value="{{dishKeyword}}" placeholder="搜索菜名、标签或分类" bindinput="dishSearch" confirm-type="search" /><text wx:if="{{dishKeyword}}" class="sheet-clear" bindtap="clearDishKeyword">×</text></view><view class="sheet-list"><view wx:for="{{visibleDishes}}" wx:key="id" class="sheet-item {{item.id === dishId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseDish"><text class="sheet-emoji">{{item.emoji}}</text><view class="sheet-main"><text class="sheet-name">{{item.name}}</text><text class="sheet-meta">{{item.metaText}}</text></view><text wx:if="{{item.id === dishId}}" class="sheet-now">当前</text></view><view wx:if="{{!visibleDishes.length}}" class="sheet-empty">没找到匹配的菜品</view><view wx:elif="{{dishMatchTotal > visibleDishes.length}}" class="sheet-more">还有 {{dishMatchTotal - visibleDishes.length}} 道，输入关键词缩小范围</view></view><view class="sheet-new" bindtap="createDish"><text class="sheet-new-plus">+</text><text>{{dishKeyword ? '新建「' + dishKeyword + '」' : '新建菜品'}}</text></view></view></view>
    <view class="field"><view class="label">日期</view><picker mode="date" value="{{date}}" end="{{today}}" bindchange="dateChange"><view class="picker-value"><text>{{date}}</text><text class="picker-hint">选择 ›</text></view></picker></view>
    <view class="field"><view class="label">餐次</view><view class="meal-row"><view wx:for="{{meals}}" wx:key="*this" class="meal-chip {{mealType === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseMeal">{{item}}</view></view></view>
    <view class="field score-field"><view class="score-head"><view class="label">这一餐打几分</view><view class="score-number">★ {{score}}</view></view><slider min="1" max="5" step="0.5" value="{{score}}" activeColor="#E8A52A" backgroundColor="#E9E4DA" block-color="#FFFDF8" block-size="24" bindchange="scoreChange"/><view class="score-labels"><text>不太满意</text><text>非常满意</text></view></view>
    <view class="field"><view class="label">饮食状态</view><view class="status-grid"><view wx:for="{{statuses}}" wx:key="name" class="status {{status === item.name ? 'active' : ''}}" data-value="{{item.name}}" bindtap="chooseStatus"><text class="status-emoji">{{item.emoji}}</text><text>{{item.name}}</text></view></view></view>
    <view class="field no-border"><view class="label">随手记两句</view><textarea placeholder="味道、店铺、心情……" value="{{remark}}" bindinput="remarkChange" maxlength="200" /></view>
  </view>
  <button class="primary-btn save-btn" bindtap="save">{{saveText}}</button>
</view></scroll-view>
