page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page-scroll {
  flex: 1;
  overflow: hidden;
}
.intro {
  margin: 8rpx 0 28rpx;
}
.eyebrow {
  color: #e85d3f;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.page-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}
.form-card {
  padding: 0 28rpx;
}
.label {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 650;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 22rpx;
  background: #f6f2ea;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.picker-dish {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.picker-emoji {
  margin-right: 10rpx;
  font-size: 32rpx;
  line-height: 1;
}
.picker-value > text:last-child {
  color: #99958d;
  font-size: 23rpx;
  flex: none;
}
.picker-hint {
  color: #99958d;
  font-size: 23rpx;
  flex: none;
}
.meal-row {
  display: flex;
  gap: 12rpx;
}
.meal-chip {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f5f1e9;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  font-size: 25rpx;
  color: #4e4c46;
}
.meal-chip.active {
  border-color: #e85d3f;
  background: #fff0e9;
  color: #b94d35;
  font-weight: 600;
}
.score-head {
  display: flex;
  justify-content: space-between;
}
.score-number {
  color: #d99a20;
  font-size: 30rpx;
  font-weight: 700;
}
.score-labels {
  display: flex;
  justify-content: space-between;
  color: #a09c93;
  font-size: 20rpx;
}
.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
.status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #f5f1e9;
  border: 3rpx solid transparent;
  border-radius: 18rpx;
  font-size: 24rpx;
}
.status.active {
  border-color: #e85d3f;
  background: #fff0e9;
  color: #b94d35;
}
.status-emoji {
  font-size: 38rpx;
}
.field textarea {
  width: 100%;
  height: 150rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f6f2ea;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.no-border {
  border: 0;
}
.save-btn {
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 28rpx;
}
.dish-sheet {
  margin-top: 16rpx;
  padding: 12rpx;
  background: #fbf8f1;
  border: 1rpx solid #eee9e0;
  border-radius: 20rpx;
}
.sheet-search {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 18rpx;
  background: #fffdf8;
  border-radius: 16rpx;
}
.sheet-search-icon {
  margin-right: 10rpx;
  font-size: 24rpx;
}
.sheet-search-input {
  flex: 1;
  font-size: 25rpx;
}
.sheet-clear {
  padding: 0 10rpx;
  color: #a8a49b;
  font-size: 30rpx;
  line-height: 72rpx;
}
.sheet-list {
  margin-top: 6rpx;
}
.sheet-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
}
.sheet-item.active {
  background: #fff0e9;
}
.sheet-emoji {
  margin-right: 14rpx;
  font-size: 34rpx;
}
.sheet-main {
  flex: 1;
  min-width: 0;
}
.sheet-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}
.sheet-meta {
  margin-top: 4rpx;
  color: #99958d;
  font-size: 21rpx;
}
.sheet-now {
  color: #e85d3f;
  font-size: 21rpx;
}
.sheet-empty {
  padding: 28rpx 12rpx;
  color: #a8a49b;
  font-size: 23rpx;
  text-align: center;
}
.sheet-more {
  padding: 14rpx 12rpx;
  color: #b0aca3;
  font-size: 21rpx;
  text-align: center;
}
.sheet-new {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 8rpx;
  background: #fffdf8;
  border: 1rpx dashed #e3d9c9;
  border-radius: 16rpx;
  color: #c2563a;
  font-size: 25rpx;
  font-weight: 600;
}
.sheet-new-plus {
  margin-right: 8rpx;
  font-size: 30rpx;
}
