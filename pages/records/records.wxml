<import src="/styles/tabbar.wxml" />
<navigation-bar title="饮食记录" back="{{false}}" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view class="page-pad">
  <view class="title-row"><view class="title-main"><view class="page-title">一日三餐，好好吃饭</view><view class="muted count">唯有美食与爱，不可辜负！</view></view><view class="add-btn" hover-class="add-btn-hover" bindtap="addToday">＋ 记一餐</view></view>

  <view class="search-bar">
    <text class="search-emoji">🔍</text>
    <input class="search-input" value="{{keyword}}" placeholder="搜菜名、备注、状态" placeholder-class="search-ph" confirm-type="search" bindinput="onSearchInput" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">清空</text>
  </view>

  <block wx:if="{{!searching}}">
  <view class="calendar card" bindtouchstart="onCalendarTouchStart" bindtouchend="onCalendarTouchEnd">
    <view class="month-head"><text class="month-arrow {{canPrev ? '' : 'disabled'}}" bindtap="prevMonth">‹</text><view class="month-center"><text class="month-title">{{monthTitle}}</text><text wx:if="{{showBackToMonth}}" class="month-back" bindtap="backToMonth">今</text><text wx:if="{{selectedDate}}" class="month-back" bindtap="clearDate">月</text></view><text class="month-arrow {{canNext ? '' : 'disabled'}}" bindtap="nextMonth">›</text></view>
    <view class="week-row"><text wx:for="{{weeks}}" wx:key="*this">{{item}}</text></view>
    <view class="day-grid"><view wx:for="{{cells}}" wx:key="key" class="day {{item.empty ? 'empty-day' : ''}} {{item.future ? 'future' : ''}} {{item.hasMood ? 'with-mood' : ''}} {{selectedDate === item.date ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><view class="day-num {{item.isToday ? 'is-today' : ''}} {{item.hasFestival ? 'festival' : ''}} {{item.hasAnniversary ? 'anniversary' : ''}}"><text>{{item.day}}</text><view wx:if="{{item.hasReminder}}" class="day-dot"></view></view><image wx:if="{{item.moodIcon}}" class="day-mark-img" mode="aspectFit" src="{{item.moodIcon}}" /><text wx:elif="{{item.mark}}" class="day-mark">{{item.mark}}</text></view></view>
  </view>

  <view wx:if="{{festivals.length}}" class="festival-card card">
    <view class="festival-head"><text class="festival-eyebrow">FESTIVAL</text><text class="festival-head-title">{{festivalTitle}}</text></view>
    <view wx:for="{{festivals}}" wx:key="key" class="festival-row {{index === 0 ? 'first' : ''}}">
      <view class="festival-when {{item.offset === 0 ? 'today' : ''}}">{{item.whenText}}</view>
      <view class="festival-main">
        <view class="festival-line"><text class="festival-emoji">{{item.emoji}}</text><text class="festival-name">{{item.name}}</text><text class="festival-tag">{{item.kindText}}</text></view>
        <view wx:if="{{item.food}}" class="festival-food">吃点：{{item.food}}</view>
        <view wx:elif="{{item.line}}" class="festival-note">{{item.line}}</view>
      </view>
      <view class="festival-date">{{item.lunarText || item.dateText}}<text class="festival-weekday">{{item.weekday}}</text></view>
    </view>
  </view>

  <view wx:if="{{emptyHint}}" class="today-hint card" data-date="{{hintTargetDate}}" bindtap="openHintCheckin">
    <view class="hint-emoji">{{weatherEmoji}}</view>
    <view class="hint-main"><view class="hint-title">{{emptyHint.title}}</view><view class="hint-desc">{{emptyHint.desc}}</view></view>
    <view class="hint-action">写心情</view>
  </view>

  <view wx:if="{{days.length}}" class="record-head"><text class="record-count">{{monthCount}} 餐</text></view>

  <view wx:if="{{days.length}}" class="day-list">
    <view wx:for="{{days}}" wx:key="date" class="day-card card">
      <view class="day-head">
        <view class="day-mood {{item.moodIcon ? 'filled' : ''}}" data-date="{{item.date}}" bindtap="openCheckin"><image wx:if="{{item.moodIcon}}" class="day-mood-img" mode="aspectFit" src="{{item.moodIcon}}" /><text wx:else>＋</text></view>
        <view class="day-title" data-date="{{item.date}}" bindtap="openCheckin">
          <view class="day-line"><text class="day-label">{{item.label}}</text><text class="day-weekday">{{item.weekday}}</text><text wx:if="{{item.isToday}}" class="day-today">今天</text></view>
          <view class="day-sub">{{item.moodLabel ? '心情 ' + item.moodLabel : '还没写心情'}} · {{item.mealCount}} 餐</view>
        </view>
        <view class="day-add" data-date="{{item.date}}" catchtap="addMeal">补一餐</view>
      </view>
      <view wx:if="{{item.note}}" class="day-note" data-date="{{item.date}}" bindtap="openCheckin">{{item.note}}</view>
      <view wx:if="{{item.meals.length}}" class="meal-list">
        <view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="id" class="meal" data-id="{{meal.id}}" bindtap="editRecord" bindlongpress="removeRecord">
          <text class="meal-emoji">{{meal.emoji}}</text>
          <text class="meal-type">{{meal.mealType}}</text>
          <text wx:if="{{meal.timeText}}" class="meal-time">{{meal.timeText}}</text>
          <text class="meal-name">{{meal.dishName}}</text>
          <text class="meal-score">★ {{meal.score}}</text>
        </view>
      </view>
      <view wx:else class="meal-empty">这一天还没有记录餐食</view>
    </view>
  </view>
  <view wx:elif="{{!emptyHint}}" class="empty card month-empty">{{emptyTitle}}<br/><text>{{emptySub}}</text></view>
  </block>
  <block wx:else>
    <view wx:if="{{hits.length}}" class="search-summary">找到 {{hits.length}} 条{{hits.length >= 50 ? '，只显示最近 50 条' : ''}}</view>
    <view wx:if="{{hits.length}}" class="hit-list">
      <view wx:for="{{hits}}" wx:key="id" class="hit card" data-id="{{item.id}}" bindtap="editRecord">
        <text class="hit-emoji">{{item.emoji}}</text>
        <view class="hit-body">
          <view class="hit-line"><text class="hit-name">{{item.dishName}}</text><text class="hit-score">★ {{item.score}}</text></view>
          <view class="hit-sub">{{item.dateText}} · {{item.weekday}} · {{item.mealType}}{{item.timeText ? ' ' + item.timeText : ''}}</view>
          <view wx:if="{{item.noteText}}" class="hit-note">{{item.noteText}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty card">没有匹配的记录<br/><text>换个菜名或备注里的词试试</text></view>
  </block>
</view></scroll-view>
<template is="app-tabbar" data="{{...tabbar}}" />
