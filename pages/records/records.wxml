<navigation-bar title="饮食记录" back="{{false}}" color="#292824" background="#F7F4ED"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list"><view class="page-pad">
  <view class="title-row"><view><view class="page-title">吃饭日历</view><view class="muted count">翻翻最近都吃了什么</view></view><button class="add-btn" bindtap="addRecord">＋ 记录一餐</button></view>
  <view class="calendar card"><view class="month-head"><text bindtap="prevMonth">‹</text><text class="month-title">{{monthTitle}}</text><text bindtap="nextMonth">›</text></view><view class="week-row"><text wx:for="{{weeks}}" wx:key="*this">{{item}}</text></view><view class="day-grid"><view wx:for="{{cells}}" wx:key="key" class="day {{item.empty ? 'empty-day' : ''}} {{selectedDate === item.date ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><text>{{item.day}}</text><text wx:if="{{item.count}}" class="day-mark">{{item.emoji}}</text></view></view></view>
  <view class="record-head"><view><text class="section-title">{{selectedDate ? '当天记录' : '本月记录'}}</text><text class="record-count">{{monthCount}} 餐</text></view><text wx:if="{{selectedDate}}" class="clear" bindtap="clearDate">查看整月</text></view>
  <view wx:if="{{groups.length}}"><view wx:for="{{groups}}" wx:for-item="group" wx:key="date" class="date-group"><view class="date-label">{{group.label}}</view><view class="card group-card"><view wx:for="{{group.records}}" wx:for-item="record" wx:key="id" class="record" data-id="{{record.id}}" bindlongpress="removeRecord"><view class="meal-badge">{{record.mealType}}</view><view class="record-main"><view class="record-name">{{record.dishName}}</view><view class="record-note">{{record.noteText}}</view></view><view class="record-score">★ {{record.score}}</view></view></view></view></view>
  <view wx:else class="empty card">这个月还没有记录<br/><text>记下第一餐，让生活有迹可循</text></view>
</view></scroll-view>
