page{height:100vh;display:flex;flex-direction:column}.page-scroll{flex:1;overflow:hidden}.title-row{display:flex;justify-content:space-between;align-items:center;margin:12rpx 0 28rpx}.page-title{font-size:44rpx;font-weight:800}.count{margin-top:8rpx;font-size:24rpx}.add-btn{height:72rpx;line-height:72rpx;padding:0 25rpx;background:#E85D3F;color:#fff;border-radius:999rpx;font-size:25rpx}.calendar{padding:26rpx}.month-head{display:flex;justify-content:space-between;align-items:center;padding:0 10rpx 20rpx;font-size:42rpx}.month-title{font-size:29rpx;font-weight:700}.week-row,.day-grid{display:grid;grid-template-columns:repeat(7,1fr)}.week-row text{text-align:center;color:#A19D94;font-size:21rpx}.day{display:flex;align-items:center;flex-direction:column;height:70rpx;margin-top:12rpx;padding-top:8rpx;box-sizing:border-box;border-radius:18rpx;font-size:23rpx}.day.selected{background:#292824;color:#fff}.day-mark{margin-top:2rpx;font-size:20rpx;line-height:22rpx}.record-head{display:flex;justify-content:space-between;align-items:center;margin:30rpx 2rpx 18rpx}.record-count{margin-left:14rpx;color:#9B978E;font-size:22rpx}.clear{color:#E85D3F;font-size:23rpx}.date-group{margin-bottom:20rpx}.date-label{margin:0 0 10rpx 8rpx;color:#7C7972;font-size:23rpx}.group-card{padding:0 24rpx}.record{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #EEE9E0}.record:last-child{border:0}.meal-badge{width:74rpx;padding:10rpx 0;text-align:center;background:#F2E8DC;color:#A55B43;border-radius:14rpx;font-size:21rpx}.record-main{flex:1;min-width:0;margin-left:20rpx}.record-name{font-size:29rpx;font-weight:700}.record-note{margin-top:7rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#97938A;font-size:21rpx}.record-score{color:#D99A20;font-size:24rpx;font-weight:700}.empty text{font-size:23rpx}

/* Skyline 对 CSS Grid 的支持不完整，日历固定使用 Flex 七等分。 */
.week-row {
  display: flex;
  width: 100%;
}
.week-row text {
  display: block;
  width: 14.2857%;
  flex: none;
}
.day-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}
.day {
  width: 14.2857%;
  flex: none;
}
