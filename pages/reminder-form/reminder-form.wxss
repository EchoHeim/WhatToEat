page { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; overflow: hidden; }
.form-page { padding-bottom: 60rpx; }

.intro { margin: 8rpx 0 28rpx; }
.eyebrow { color: #E85D3F; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }
.page-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 800; }

.form-card { padding: 0 28rpx; }
.field { padding: 28rpx 0; border-bottom: 1rpx solid #EEE9E0; }
.field.no-border { border: 0; }
.label { display: block; margin-bottom: 16rpx; font-size: 26rpx; font-weight: 650; }
.label-extra { margin-left: 10rpx; color: #A09C93; font-size: 21rpx; font-weight: 400; }
.label.no-margin { margin-bottom: 0; }
.field-hint { margin-top: 12rpx; color: #A09C93; font-size: 21rpx; line-height: 1.5; }

.text-input { width: 100%; height: 76rpx; padding: 0 22rpx; box-sizing: border-box; background: #F6F2EA; border-radius: 16rpx; font-size: 27rpx; }

.segment { display: flex; padding: 6rpx; background: #F2EEE5; border-radius: 16rpx; }
.seg { flex: 1; padding: 16rpx 0; text-align: center; border-radius: 12rpx; color: #6C6961; font-size: 26rpx; }
.seg.active { background: #FFFDF8; color: #292824; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(67, 49, 34, .08); }

.picker-value, .small-picker { display: flex; align-items: center; justify-content: space-between; height: 76rpx; padding: 0 22rpx; background: #F6F2EA; border-radius: 16rpx; font-size: 27rpx; }
/* 纪念日「每年」是定死的，用一行只读值展示，不做成可点的 chip */
.fixed-line { display: flex; align-items: center; height: 76rpx; padding: 0 22rpx; background: #F6F2EA; border-radius: 16rpx; font-size: 27rpx; color: #8B8982; }
.picker-value text:last-child { color: #99958D; font-size: 23rpx; }
.small-picker { font-size: 24rpx; }
.two-col { display: flex; width: 100%; }
.two-col > picker { flex: 1; min-width: 0; }
.two-col > picker:first-child { margin-right: 18rpx; }
.resolve { margin-top: 14rpx; color: #A09C93; font-size: 21rpx; }

.chip-row { display: flex; flex-wrap: wrap; }
.chip { margin: 0 14rpx 12rpx 0; padding: 14rpx 26rpx; background: #F5F1E9; border: 3rpx solid transparent; border-radius: 999rpx; color: #6C6961; font-size: 24rpx; }
.chip.active { border-color: #E85D3F; background: #FFF0E9; color: #B94D35; font-weight: 650; }

/* 「每 N 天」的步进器：选中「每天」时出现在循环方式下面 */
.interval-row { display: flex; align-items: center; margin: 2rpx 0 4rpx; }
.interval-label { color: #6C6961; font-size: 25rpx; }
.stepper { display: flex; align-items: center; margin: 0 16rpx; background: #F6F2EA; border-radius: 18rpx; }
.step-btn { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 64rpx; color: #B94D35; font-size: 32rpx; line-height: 1; }
.step-btn-hover { opacity: .55; }
.step-input { width: 82rpx; height: 64rpx; text-align: center; color: #4E4C46; font-size: 27rpx; font-weight: 650; }

.switch-row { display: flex; align-items: center; justify-content: space-between; }
.switch-text { flex: 1; min-width: 0; margin-right: 20rpx; }

.preview { display: flex; align-items: center; margin-top: 24rpx; padding: 26rpx 28rpx; }
.preview-icon { margin-right: 18rpx; font-size: 38rpx; }
.preview-text { flex: 1; color: #4E4C46; font-size: 25rpx; line-height: 1.5; }

/* 微信推送预览：5 行照着服务通知排，右边小字是这行来自哪个设置项 */
.notify-card { margin-top: 20rpx; padding: 24rpx 28rpx 22rpx; }
.notify-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.notify-title { color: #292824; font-size: 26rpx; font-weight: 700; }
.notify-badge { padding: 4rpx 14rpx; background: #F2EEE5; color: #8B8982; border-radius: 999rpx; font-size: 19rpx; }
.notify-row { display: flex; align-items: baseline; padding: 15rpx 0; border-bottom: 1rpx solid #F1EDE4; }
.notify-row.last { border: 0; }
.notify-label { flex: none; width: 132rpx; color: #8B8982; font-size: 23rpx; }
.notify-value { flex: 1; min-width: 0; color: #292824; font-size: 26rpx; word-break: break-all; }
.notify-source { flex: none; margin-left: 14rpx; color: #B0ACA3; font-size: 19rpx; }
.notify-foot { margin-top: 12rpx; color: #A09C93; font-size: 20rpx; line-height: 1.55; }

.save-btn { height: 92rpx; line-height: 92rpx; margin-top: 28rpx; }
.delete-btn { height: 88rpx; line-height: 88rpx; margin-top: 18rpx; color: #C84832; }
