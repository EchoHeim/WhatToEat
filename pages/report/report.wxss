page { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; overflow: hidden; }

.month-head { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 28rpx; }
/* 左右箭头等宽，中间这块才能落在正中（和记录页同一套做法，改一处记得同步另一处） */
.month-center { display: flex; align-items: center; justify-content: center; }
.month-title { font-size: 36rpx; font-weight: 700; }
/* 往前翻远了回得来：只在本月之外显示 */
.month-back {
  margin-left: 12rpx; padding: 6rpx 16rpx;
  background: #F7E7DD; color: #B7543D;
  border-radius: 999rpx; font-size: 20rpx; font-weight: 700; line-height: 1.3;
}
.month-arrow { padding: 10rpx 26rpx; font-size: 40rpx; color: #292824; }
.month-arrow.disabled { color: #D8D3C8; }

.stat-row { display: flex; gap: 16rpx; }
.stat { flex: 1; padding: 26rpx 20rpx; text-align: center; }
.stat-value { font-size: 46rpx; font-weight: 700; line-height: 1.2; }
.stat-label { margin-top: 8rpx; color: #9B978E; font-size: 21rpx; }
.delta-line { margin: 18rpx 4rpx 26rpx; color: #8B877E; font-size: 23rpx; }

.block { margin-bottom: 22rpx; padding: 28rpx 30rpx; }
.block-title { margin-bottom: 22rpx; font-size: 28rpx; font-weight: 700; }
.block-note { margin-top: 12rpx; color: #B0ACA3; font-size: 20rpx; line-height: 1.5; }

.top-row { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-bottom: 1rpx solid #F2EEE5; }
.top-row:last-child { border-bottom: 0; }
.top-rank { width: 34rpx; color: #C4BFB4; font-size: 24rpx; font-weight: 700; }
.top-emoji { font-size: 34rpx; }
.top-name { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.top-score { flex: none; color: #E3A228; font-size: 22rpx; }
.top-count { flex: none; width: 90rpx; text-align: right; color: #9B978E; font-size: 22rpx; }

.bars { display: flex; align-items: flex-end; gap: 3rpx; height: 230rpx; padding: 0 2rpx; }
.bar-col { flex: 1; height: 100%; display: flex; align-items: flex-end; }
.bar { width: 100%; min-height: 6rpx; border-radius: 4rpx 4rpx 0 0; background: #E4DFD4; }
.bar.low { background: #E4DFD4; }
.bar.mid { background: #EFA37F; }
.bar.good { background: #E85D3F; }
.chart-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; color: #B0ACA3; font-size: 20rpx; }
.chart-foot .best { color: #B7543D; }

.dist-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.dist-row:last-child { margin-bottom: 0; }
.dist-name { flex: none; width: 96rpx; color: #67645D; font-size: 24rpx; }
.dist-track { flex: 1; height: 16rpx; background: #F2EEE5; border-radius: 999rpx; overflow: hidden; }
.dist-fill { height: 100%; border-radius: 999rpx; background: #E85D3F; min-width: 6rpx; }
.dist-fill.taste { background: #A8C69F; }
.dist-value { flex: none; width: 56rpx; text-align: right; color: #9B978E; font-size: 22rpx; }

.empty { padding: 100rpx 40rpx; text-align: center; }
.empty-sub { display: block; margin-top: 14rpx; color: #B0ACA3; font-size: 22rpx; line-height: 1.6; }
