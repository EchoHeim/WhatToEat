/* 悬浮玻璃条：由各 tab 页通过 @import 引入，必须在页面根层（不能塞进 custom-tab-bar 组件） */
.app-tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  height: 122rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: rgba(255, 253, 248, .42);
  border: 1rpx solid rgba(255, 255, 255, .5);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 46rpx rgba(67, 49, 34, .14), 0 2rpx 8rpx rgba(67, 49, 34, .05);
  backdrop-filter: blur(40rpx) saturate(170%);
}

.app-tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 98rpx;
  border-radius: 999rpx;
}

/* 选中项垫一层极淡的橙，不抢图标本身 */
.app-tab.on { background: rgba(232, 93, 63, .10); }
/* 按下反馈：手指落上去就该有反应，否则分不清是没点中还是没响应 */
.app-tab-hover { opacity: .55; }

.app-tab-icon { width: 44rpx; height: 44rpx; }
.app-tab-text { margin-top: 4rpx; color: #8B8B86; font-size: 19rpx; }
.app-tab.on .app-tab-text { color: #E85D3F; font-weight: 600; }
